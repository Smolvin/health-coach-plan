{
  "name": "health-coach-plan",
  "version": "0.8.0",
  "private": true,
  "description": "Персональный проект: анкетирование клиентов, программы тренировок и планы питания. Работает через Telegram-бота и MySQL, всё заворачивается в Docker. Версия растёт по мере доработки проекта.",
  "main": "src/bot.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "db:check": "node scripts/check-db.js",
    "migrate": "node scripts/migrate.js",
    "docker:up": "docker compose up --build",
    "docker:up:local-db": "docker compose --profile local-db up --build",
    "docker:down": "docker compose --profile local-db down"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.0",
    "telegraf": "^4.16.3"
  },
  "keywords": [
    "fitness",
    "nutrition",
    "training-plan",
    "diet-plan",
    "telegram-bot"
  ]
}
