# --- Telegram-бот ---
# Токен от @BotFather: /newbot (или /mybots -> выбрать бота -> API Token).
BOT_TOKEN=

# Telegram ID владельца проекта — единственный, кто может удалять админов
# (добавлять новых админов могут и владелец, и уже назначенные админы).
# Узнать свой ID можно, написав боту /whoami.
OWNER_TELEGRAM_ID=

# --- Веб-админка (src/admin/server.js) ---
# Список клиентов и ответов на анкету, редактирование вопросов/стратегий без
# прямого SQL. Отдельный процесс от бота, закрыт HTTP Basic Auth.
ADMIN_PORT=4000
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=

# --- MinIO (хранилище фото залов/оборудования) ---
# S3-совместимое хранилище; endpoint должен быть доступен из докер-сети, где
# крутятся контейнеры бота/админки (docker-compose.yml подключает их к внешней
# сети, где живёт MinIO — поменяй под свою инфраструктуру, если MinIO в другом месте).
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=health-coach-plan

# Папка на хосте с медиа для массового импорта (scripts/import_media.js),
# монтируется в контейнер bot по пути /import (read-only, docker-compose.yml).
IMPORT_ASSETS_DIR=/Users/Shared/assets

# --- База данных (MySQL) ---
# Один и тот же набор переменных подходит для любого сценария —
# просто меняешь значения под свою ситуацию:
#
#  1) MySQL в Docker Compose этого проекта, своя изолированная база на проект:
#       docker compose --profile local-db up --build
#       DB_HOST=mysql
#       DB_PORT=3306
#
#  2) MySQL уже установлен на этой машине (один инстанс на все проекты):
#       DB_HOST=127.0.0.1          # бот запущен без Docker
#       DB_HOST=host.docker.internal  # бот запущен в Docker (см. docker-compose.yml)
#       DB_PORT=3306
#
#  3) MySQL на удалённом VPS:
#       DB_HOST=<ip-или-домен-vps>
#       DB_PORT=3306
#       DB_SSL=true
#
DB_HOST=mysql
DB_PORT=3306
DB_NAME=health
DB_USER=health
DB_PASSWORD=health
DB_SSL=false

# Пароль root — нужен только локальному MySQL-контейнеру этого проекта
# (docker-compose.yml, профиль local-db), для VPS/машинного MySQL не используется.
DB_ROOT_PASSWORD=change-me

# Порт, на который локальный MySQL-контейнер публикуется на хосте.
# Не 3306, чтобы не конфликтовать с уже установленным на машине MySQL.
DB_LOCAL_PORT=3307
